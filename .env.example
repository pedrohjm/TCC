# Copie este arquivo para `.env` e preencha os valores.
#
#   cp .env.example .env
#
# O `.env` de verdade NÃO vai pro repositório (está no .gitignore) — este
# aqui vai, e serve só pra dizer quais variáveis existem. Nunca coloque um
# valor real neste arquivo.

# Conexão do Prisma com o Postgres. O host/porta/senha precisam bater com
# as variáveis POSTGRES_* abaixo, que são as que sobem o banco no Docker.
DATABASE_URL="postgresql://sellregister:TROQUE_ESTA_SENHA@localhost:5433/sellregister?schema=public"

# Chave que o NextAuth usa pra assinar o cookie de sessão (JWT). Gere a sua:
#
#   npx auth secret          (escreve direto no .env)
#   openssl rand -base64 32  (ou copie a saída aqui)
#
# Trocar esta chave desloga todo mundo — é o efeito esperado.
AUTH_SECRET="gere-a-sua-com-npx-auth-secret"

# Postgres do docker-compose.yml. O compose recusa a subir sem eles, de
# propósito: assim ninguém sobe o banco com uma senha padrão fraca sem
# perceber. A senha aqui é a mesma que aparece na DATABASE_URL.
POSTGRES_USER=sellregister
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=sellregister
# Porta no seu computador. 5433 pra não brigar com um Postgres já instalado.
POSTGRES_PORT=5433
