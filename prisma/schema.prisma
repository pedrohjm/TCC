// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  DONO
  ATENDENTE
}

enum FormaPagamento {
  DINHEIRO
  CARTAO
  PIX
}

// Como o preço de um produto é formado. O caso comum é UNITARIO
// (preço × quantidade); os outros três existem porque a loja cobra assim:
//
// - ESCALONADO: a partir de `quantidadeRegra` unidades, cada uma passa a
//   custar `precoRegra`. Ex.: pote de 1800 ml sai a 27,00 sozinho, mas
//   levando 2 os DOIS saem a 25,00 (= 50,00, não 52,00).
// - PACOTE: a cada `quantidadeRegra` unidades cobra-se `precoRegra`, e o
//   que sobra sai pelo `preco` avulso. Ex.: picolé é 3,00 avulso e 4 por
//   10,00 — então 5 picolés = 10,00 + 3,00 = 13,00 e 12 = 30,00.
// - LIVRE: não tem preço de tabela; o valor é digitado na hora da venda.
//   É o self-service, que é vendido por peso.
enum RegraPreco {
  UNITARIO
  ESCALONADO
  PACOTE
  LIVRE
}

// Encomenda: o cliente pede hoje e busca depois. Caixa ou pote — as duas
// formas em que a loja vende sorvete encomendado.
enum TipoEncomenda {
  POTE
  CAIXA
}

// O caminho de uma encomenda no balcão. O usuário pediu "Feito / Entregue",
// mas descreveu o uso como "saber qual deveria ser feito ainda e qual já
// está pronto pra retirada" — o "ainda não feito" é um terceiro estado, e
// sem ele a tela não responderia justamente a primeira pergunta.
enum StatusEncomenda {
  PENDENTE
  FEITO
  ENTREGUE
}

enum CategoriaSabor {
  DOCE
  FRUTA
  AZEDO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(ATENDENTE)
  vendas    Venda[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produto {
  id    Int     @id @default(autoincrement())
  nome  String
  /// Preço avulso, de uma unidade. Nas regras PACOTE é o preço do que
  /// sobra fora dos pacotes; na LIVRE não é usado (fica 0).
  preco Decimal @db.Decimal(10, 2)

  regraPreco      RegraPreco @default(UNITARIO)
  /// ESCALONADO: a partir de quantas unidades a regra vale.
  /// PACOTE: quantas unidades formam um pacote.
  quantidadeRegra Int?
  /// ESCALONADO: o preço unitário que passa a valer.
  /// PACOTE: o preço de um pacote fechado.
  precoRegra      Decimal?   @db.Decimal(10, 2)
  /// Produtos com o mesmo grupo somam quantidade pra decidir se a regra
  /// pegou. É o que faz o pote de açaí contar junto com o pote comum: 1 de
  /// cada já são 2 potes, então o comum cai pra 25,00 — mas o açaí, que é
  /// UNITARIO, continua no preço dele. Vale só como gatilho da regra.
  grupoPreco      String?

  /// Qual tipo de encomenda este produto atende. É o que deixa a entrega
  /// virar venda sem nome de produto escrito no código: ao entregar um
  /// POTE, a venda sai no produto marcado com POTE, pelo preço de tabela
  /// dele (inclusive as regras de quantidade de lib/precos.ts). Único
  /// porque só pode haver um produto por tipo; null = não é encomendável.
  tipoEncomenda TipoEncomenda? @unique

  /// Posição na tela de registrar venda. É por ela que sai a numeração do
  /// atalho de teclado (1-9), então a ordem importa: o que mais sai fica
  /// nos primeiros números. Em ordem alfabética a tecla 1 cairia na
  /// "Caixa", de 120 reais, que é o item mais raro e o erro mais caro.
  ordem      Int         @default(0)
  ativo      Boolean     @default(true)
  itensVenda ItemVenda[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Venda {
  id             Int            @id @default(autoincrement())
  valorTotal     Decimal        @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  /// Anotação livre do balcão sobre o pedido inteiro (nome do cliente, o
  /// que foi o self-service, alguma observação). Opcional.
  descricao      String?
  dataHora       DateTime       @default(now())
  /// Qual encomenda gerou esta venda. Vira null se a encomenda for apagada
  /// na limpeza da lista — a venda continua, porque é registro de dinheiro.
  /// Único: uma encomenda entregue vira exatamente uma venda (marcar
  /// "entregue" duas vezes não duplica).
  encomendaId Int?       @unique
  encomenda   Encomenda? @relation(fields: [encomendaId], references: [id])
  /// "Esta venda veio de uma encomenda", e continua verdade mesmo depois
  /// que a encomenda for apagada. Sem isto, limpar a lista de entregues
  /// mexeria no indicador do dashboard sem ninguém perceber.
  deEncomenda Boolean @default(false)
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  itens          ItemVenda[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ItemVenda {
  id            Int     @id @default(autoincrement())
  vendaId       Int
  venda         Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  /// Preço de tabela na hora da venda, guardado pra referência histórica.
  precoUnitario Decimal @db.Decimal(10, 2)
  /// Quanto essa linha custou de fato. Não dá pra derivar de
  /// `precoUnitario × quantidade` desde que existem pacotes: 6 picolés
  /// custam 16,00, e 16/6 não fecha em centavos. Quem manda no total da
  /// venda é a soma dos subtotais.
  subtotal      Decimal @db.Decimal(10, 2)
}

// Sabores disponíveis nos potes de 1800 ml — puramente informativo pro
// cliente ver o que tem em estoque. É um catálogo separado do Produto:
// Produto é o que entra no carrinho da venda (pote, picolé...), Sabor é só
// "qual gosto de sorvete tem hoje", sem preço nem venda direta.
//
// A lista em si mora em prisma/sabores.ts (é lá que se edita, e
// `npm run sabores` traz pro banco sem mexer no resto).
model Sabor {
  id   Int    @id @default(autoincrement())
  /// Único porque é a chave pela qual prisma/sabores.ts atualiza o banco:
  /// mesmo nome = mesmo sabor, atualiza; nome novo = sabor novo.
  nome String @unique
  /// Lista, não valor único: "Morango" é Fruta E Doce, "Limão" é Fruta E
  /// Azedo. O filtro do cardápio mostra o sabor em qualquer uma delas.
  categorias CategoriaSabor[]
  descricao  String
  foto       String?
  ativo      Boolean  @default(true)
  encomendas Encomenda[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Encomenda feita no balcão pra retirar depois. Substituiu o antigo model
// `Reserva` (nome + data + status, sem produto), que nunca teve tela e
// era um subconjunto disto — aqui importa o QUE foi pedido, porque é isso
// que alguém precisa produzir.
//
// **Entregar gera a venda**: ao marcar ENTREGUE, a rota cria a Venda com o
// produto correspondente ao `tipo` (ver `Produto.tipoEncomenda`), pelo
// preço de tabela, e amarra as duas pelo `Venda.encomendaId`. Desfazer a
// entrega apaga essa venda.
model Encomenda {
  id          Int    @id @default(autoincrement())
  nomeCliente String
  /// Qual sabor foi encomendado. Relação com o catálogo em vez de texto
  /// solto: evita "morango"/"Morango"/"morago" virarem pedidos diferentes.
  saborId Int
  sabor   Sabor @relation(fields: [saborId], references: [id])
  tipo    TipoEncomenda
  /// Quantos potes/caixas do mesmo sabor — senão 3 potes virariam 3 linhas
  /// iguais na lista de produção.
  quantidade Int @default(1)
  /// Quando o cliente vem buscar. É por ela que a lista se ordena: o que
  /// vence antes aparece primeiro.
  dataEntrega DateTime
  status      StatusEncomenda @default(PENDENTE)
  /// Recado do pedido ("sem açúcar", "escrever Parabéns na tampa").
  observacao String?
  /// A venda gerada quando a encomenda foi entregue. Null enquanto não
  /// foi. Desfazer a entrega apaga essa venda (ver o PATCH da rota).
  venda Venda?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, dataEntrega])
}

model FechamentoCaixa {
  id            Int      @id @default(autoincrement())
  data          DateTime @unique
  totalDinheiro Decimal  @db.Decimal(10, 2)
  totalCartao   Decimal  @db.Decimal(10, 2)
  totalPix      Decimal  @db.Decimal(10, 2)
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
