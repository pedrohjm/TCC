# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o modelo sem valores, que precisa ir junto pra quem clonar saber
# quais variáveis o projeto usa.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Modelos/referências visuais que o usuário mandou (PDFs e prints de outros
# sites, usados só como base pro design). Ficam na máquina, não no
# repositório: são material de terceiros e não fazem parte do app —
# o que veio de cada um está registrado no CLAUDE.md.
/public/images/modelo/

# prisma agent-editor skill bundles (auto-installed by `prisma init`, not app code)
/.agents/
/.claude/skills/
/.windsurf/
/skills-lock.json
